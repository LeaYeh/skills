{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/checkpoint-session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/checkpoint-warn.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "copilot-review@appleboy-skills": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "learn-mentor@leayeh-skills": true,
    "commit-splitter@leayeh-skills": true,
    "diagnose@leayeh-skills": true,
    "grill-with-docs@leayeh-skills": true,
    "triage@leayeh-skills": true,
    "improve-codebase-architecture@leayeh-skills": true,
    "tdd@leayeh-skills": true,
    "to-issues@leayeh-skills": true,
    "to-prd@leayeh-skills": true,
    "zoom-out@leayeh-skills": true,
    "prototype@leayeh-skills": true,
    "caveman@leayeh-skills": true,
    "grill-me@leayeh-skills": true,
    "grill-graph@leayeh-skills": true,
    "handoff@leayeh-skills": true,
    "write-a-skill@leayeh-skills": true,
    "checkpoint@leayeh-skills": true,
    "record-adr@leayeh-skills": true,
    "architecture-diagram@leayeh-skills": true,
    "init-project@leayeh-skills": true,
    "understand-anything@understand-anything": true
  },
  "extraKnownMarketplaces": {
    "appleboy-skills": {
      "source": {
        "source": "github",
        "repo": "appleboy/skills"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "leayeh-skills": {
      "source": {
        "source": "github",
        "repo": "LeaYeh/skills"
      }
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Lum1104/Understand-Anything"
      }
    }
  },
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
